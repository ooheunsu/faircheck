# Gemini API 키입니다. 실제 키는 .env에만 넣고 커밋하지 않습니다.
GOOGLE_API_KEY=your_google_api_key_here

# 의결서 ChromaDB 폴더 위치입니다. DVC pull 후 보통 repo 안의 db/chroma_bge를 사용합니다.
FAIRCHECK_DECISION_CHROMA_DIR=/path/to/faircheck-repo/db/chroma_bge

# 의결서 BM25 pickle 파일 위치입니다. DVC pull 후 보통 repo 안의 db/bm25_index.pkl을 사용합니다.
FAIRCHECK_DECISION_BM25_PATH=/path/to/faircheck-repo/db/bm25_index.pkl

# 의결서 BGE-M3 컬렉션 이름입니다.
FAIRCHECK_DECISION_COLLECTION=decisions_bge

# 의결서 원문 PDF가 들어 있는 폴더입니다. PDF는 Git에 올리지 않고 로컬/DVC 경로만 연결합니다.
FAIRCHECK_DECISION_PDF_DIR=/path/to/faircheck-repo/db/decision_originals

# 법령 ChromaDB 폴더 위치입니다. 실제 경로는 .env에 적고, .env는 커밋하지 않습니다.
FAIRCHECK_STATUTE_CHROMA_DIR=/path/to/faircheck_chroma

# 법령 BM25 pickle 파일 위치입니다. 실제 경로는 .env에 적고, .env는 커밋하지 않습니다.
FAIRCHECK_STATUTE_BM25_PATH=/path/to/statute_bm25_index.pkl

# 반드시 BGE-M3로 만든 statutes_bge 컬렉션을 사용합니다.
FAIRCHECK_STATUTE_COLLECTION=statutes_bge

# Hugging Face 모델 캐시 위치입니다. 생략하면 Hugging Face 기본 캐시를 사용합니다.
FAIRCHECK_HF_HOME=/path/to/faircheck-repo/hf_cache/huggingface
FAIRCHECK_TRANSFORMERS_CACHE=/path/to/faircheck-repo/hf_cache/transformers
FAIRCHECK_SENTENCE_TRANSFORMERS_HOME=/path/to/faircheck-repo/hf_cache/sentence_transformers
FAIRCHECK_TORCH_HOME=/path/to/faircheck-repo/hf_cache/torch
